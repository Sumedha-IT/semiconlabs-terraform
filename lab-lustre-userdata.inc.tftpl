# FSx Lustre: per-path mounts under /data (IT-tested form: host:/mountname/rel).
# Domain flow unchanged: PD / DV / AL / Futurense via TOOLS_LIST.
# No /efs, no softlinks, no chmod on tool trees.
mkdir -p /etc/lab
cat >/etc/lab/efs-mount.env <<'LABLUSTRENV'
STORAGE_BACKEND=lustre
DATA_ROOT=/data
FSX_DNS='${trimspace(lab_fsx_lustre_dns)}'
FSX_MOUNT_NAME='${trimspace(lab_fsx_lustre_mount_name)}'
TOOLS_LIST='${join(" ", lab_efs_tools_mount_codes)}'
LABLUSTRENV

cat >/usr/local/sbin/lab-efs-mount.sh <<'LABLUSTREMOUNT'
#!/bin/bash
# Per-path Lustre mounts (IT form), e.g.:
#   mount -t lustre 10.10.132.16:/a7xhjbev/tools/PD /data/tools/PD
# Source from actual paths only (/data/tools/PD/pdsource) — no /PD|/DV|/AL binds.
set -uo pipefail
LOG=/var/log/lab-bootstrap.log
lab_log() {
  echo "[$(date -u +'%Y-%m-%dT%H:%M:%SZ')] [lab-lustre-mount] $*" | tee -a "$LOG"
}
[ -r /etc/lab/efs-mount.env ] || { lab_log "missing /etc/lab/efs-mount.env"; exit 1; }
# shellcheck source=/dev/null
. /etc/lab/efs-mount.env
DATA_ROOT="$${DATA_ROOT:-/data}"

lab_prepare_mount_point() {
  local mp="$1"
  [ -n "$mp" ] || return 1
  [ -d "$mp" ] && return 0
  if [ -e "$mp" ]; then
    mv "$mp" "$${mp}.lab-pre-mount" 2>/dev/null || rm -f "$mp" 2>/dev/null || true
  fi
  mkdir -p "$mp" || return 1
}

lab_is_lustre_at() {
  grep -qE "[[:space:]]$${1}[[:space:]]+lustre" /proc/mounts 2>/dev/null
}

# Resolve FSX_DNS to an IP when possible (IT uses IP form).
lab_fsx_host() {
  local host ip
  host="$${FSX_DNS:-}"
  case "$host" in
    *.*) ;;
    *)
      lab_log "FAIL: FSX_DNS must be a hostname or IP (got '$host')"
      return 1
      ;;
  esac
  # Already an IPv4 literal
  case "$host" in
    *[!0-9.]* ) ;;
    *)
      echo "$host"
      return 0
      ;;
  esac
  ip=$(getent ahosts "$host" 2>/dev/null | awk 'NR==1{print $1; exit}')
  if [ -n "$ip" ]; then
    echo "$ip"
    return 0
  fi
  echo "$host"
  return 0
}

# Drop legacy full-FS mounts so /data is local and only per-path mounts remain.
lab_clear_legacy_full_mounts() {
  local m
  for m in /PD /AL /DV /tools \
    /data/tools/PD /data/tools/DV /data/tools/AL \
    /data/tools /data/pdk /data/DV /data/semicon_labs_pd /data/futurense_modules; do
    if mountpoint -q "$m" 2>/dev/null; then
      umount "$m" 2>/dev/null || umount -l "$m" 2>/dev/null || true
    fi
  done
  for m in /var/lib/lab/fsx /mnt/data /mnt/lab-fsx; do
    if lab_is_lustre_at "$m"; then
      umount "$m" 2>/dev/null || umount -l "$m" 2>/dev/null || true
      lab_log "OK: umount legacy full mount $m"
    fi
  done
  if lab_is_lustre_at /data; then
    umount /data 2>/dev/null || umount -l /data 2>/dev/null || true
    if lab_is_lustre_at /data; then
      lab_log "FAIL: /data still full lustre mount"
      return 1
    fi
    lab_log "OK: umount full lustre from /data"
  fi
  mkdir -p "$${DATA_ROOT}" 2>/dev/null || true
  return 0
}

# IT form: mount -t lustre <host>:/<mountname>/<rel> /data/<rel>
# Retries with backoff — Stop→Start often races network/FSx readiness.
lab_lustre_mount_path() {
  local rel="$1"
  local dst="$${DATA_ROOT}/$rel"
  local host spec attempt
  lab_prepare_mount_point "$dst" || return 1
  if lab_is_lustre_at "$dst"; then
    lab_log "OK: already lustre $dst"
    return 0
  fi
  host=$(lab_fsx_host) || return 1
  case "$${FSX_MOUNT_NAME}" in
    '')
      lab_log "FAIL: FSX_MOUNT_NAME empty"
      return 1
      ;;
  esac
  modprobe lustre 2>/dev/null || true
  spec="$${host}:/$${FSX_MOUNT_NAME}/$${rel}"
  for attempt in 1 2 3 4 5; do
    if lab_is_lustre_at "$dst"; then
      lab_log "OK: already lustre $dst"
      return 0
    fi
    if findmnt -n "$dst" >/dev/null 2>&1 || mountpoint -q "$dst" 2>/dev/null; then
      umount "$dst" 2>/dev/null || umount -l "$dst" 2>/dev/null || true
    fi
    if timeout 90 mount -t lustre "$spec" "$dst" 2>&1 | tee -a "$LOG"; then
      if lab_is_lustre_at "$dst"; then
        lab_log "OK: mount -t lustre $spec $dst (attempt $attempt)"
        return 0
      fi
    fi
    if timeout 90 mount -t lustre -o relatime,flock "$spec" "$dst" 2>&1 | tee -a "$LOG"; then
      if lab_is_lustre_at "$dst"; then
        lab_log "OK: mount -t lustre -o relatime,flock $spec $dst (attempt $attempt)"
        return 0
      fi
    fi
    lab_log "RETRY $attempt/5: lustre mount $spec -> $dst"
    sleep $((attempt * 3))
  done
  lab_log "FAIL: lustre mount $spec -> $dst after 5 attempts"
  return 1
}

# Domain -> ONLY the paths from the IT mount table (under /data).
# PD:  /data/semicon_labs_pd, /data/tools/PD, /data/pdk
# DV:  /data/DV, /data/tools/DV
# AL:  /data/tools/AL, /data/pdk
# FUTURENSE (backend sets when domain/org is Futurense): /data/futurense_modules
# Also mounts PD+DV when those codes are in TOOLS_LIST (Futurense → PD DV FUTURENSE).
lab_mount_domain_paths() {
  local c rel seen_pdk=0 fail=0
  mkdir -p "$${DATA_ROOT}" 2>/dev/null || true
  for c in $TOOLS_LIST; do
    [ -z "$c" ] && continue
    case "$(echo "$c" | tr '[:lower:]' '[:upper:]')" in
      PD)
        for rel in tools/PD semicon_labs_pd pdk; do
          lab_lustre_mount_path "$rel" || fail=1
        done
        seen_pdk=1
        ;;
      DV)
        for rel in tools/DV DV; do
          lab_lustre_mount_path "$rel" || fail=1
        done
        ;;
      AL)
        lab_lustre_mount_path tools/AL || fail=1
        if [ "$seen_pdk" != "1" ]; then
          lab_lustre_mount_path pdk || fail=1
          seen_pdk=1
        fi
        ;;
      FUTURENSE)
        lab_lustre_mount_path futurense_modules || fail=1
        ;;
      *)
        lab_log "WARN: unknown TOOLS_LIST code '$c'"
        ;;
    esac
  done
  return $fail
}

# Require real Lustre mounts — empty local dirs after Stop Lab must NOT count as OK.
lab_verify_mounts() {
  local c fail=0
  if lab_is_lustre_at "$${DATA_ROOT}"; then
    lab_log "VERIFY FAIL: $${DATA_ROOT} is a full lustre mount (want per-path only)"
    fail=1
  else
    lab_log "VERIFY OK: $${DATA_ROOT} is not a full FSx mount"
  fi
  for c in $TOOLS_LIST; do
    [ -z "$c" ] && continue
    case "$(echo "$c" | tr '[:lower:]' '[:upper:]')" in
      PD)
        for rel in semicon_labs_pd tools/PD pdk; do
          if lab_is_lustre_at "$${DATA_ROOT}/$rel"; then
            lab_log "VERIFY OK: $${DATA_ROOT}/$rel (lustre)"
          else
            lab_log "VERIFY FAIL: $${DATA_ROOT}/$rel not lustre-mounted"
            fail=1
          fi
        done
        if [ -f "$${DATA_ROOT}/tools/PD/pdsource" ]; then
          lab_log "VERIFY OK: /data/tools/PD/pdsource"
        else
          lab_log "VERIFY WARN: /data/tools/PD/pdsource missing"
        fi
        ;;
      DV)
        for rel in DV tools/DV; do
          if lab_is_lustre_at "$${DATA_ROOT}/$rel"; then
            lab_log "VERIFY OK: $${DATA_ROOT}/$rel (lustre)"
          else
            lab_log "VERIFY FAIL: $${DATA_ROOT}/$rel not lustre-mounted"
            fail=1
          fi
        done
        ;;
      AL)
        for rel in tools/AL pdk; do
          if lab_is_lustre_at "$${DATA_ROOT}/$rel"; then
            lab_log "VERIFY OK: $${DATA_ROOT}/$rel (lustre)"
          else
            lab_log "VERIFY FAIL: $${DATA_ROOT}/$rel not lustre-mounted"
            fail=1
          fi
        done
        ;;
      FUTURENSE)
        if lab_is_lustre_at "$${DATA_ROOT}/futurense_modules"; then
          lab_log "VERIFY OK: /data/futurense_modules (lustre)"
        else
          lab_log "VERIFY FAIL: /data/futurense_modules not lustre-mounted"
          fail=1
        fi
        ;;
    esac
  done
  return $fail
}

lab_run_mount_pass() {
  local mount_rc=0
  lab_clear_legacy_full_mounts || return 1
  if ! lsmod 2>/dev/null | grep -q lustre; then
    modprobe lustre 2>/dev/null || true
  fi
  if ! lsmod 2>/dev/null | grep -q lustre; then
    lab_log "FAIL lustre kernel module not loaded"
    return 1
  fi
  if ! command -v timeout >/dev/null 2>&1; then
    lab_log "WARN timeout command missing"
    return 1
  fi
  mkdir -p "$${DATA_ROOT}" 2>/dev/null || true
  lab_mount_domain_paths || mount_rc=1
  lab_verify_mounts || mount_rc=1
  return $mount_rc
}

lab_log "start FSx Lustre FSX_DNS=$${FSX_DNS} mount=$${FSX_MOUNT_NAME} data=$${DATA_ROOT} tools=[$TOOLS_LIST] (per-path)"
_max_pass=4
_pass=0
while [ "$_pass" -lt "$_max_pass" ]; do
  _pass=$((_pass + 1))
  lab_log "=== Lustre mount pass $_pass/$_max_pass ==="
  if lab_run_mount_pass; then
    /usr/local/sbin/lab-efs-tool-env.sh 2>/dev/null || true
    lab_log "SUMMARY OK (pass $_pass)"
    exit 0
  fi
  [ "$_pass" -lt "$_max_pass" ] && sleep $((_pass * 10))
done
lab_log "FAIL Lustre mounts after $_max_pass attempts"
exit 1
LABLUSTREMOUNT
chmod +x /usr/local/sbin/lab-efs-mount.sh

cat >/usr/local/sbin/lab-efs-tool-env.sh <<'LABEFSTOOLENV'
#!/bin/bash
# Seed /etc/lab/efs-tool-sources.lst for active domain(s).
set -uo pipefail
LOG=/var/log/lab-bootstrap.log
lab_te_log() {
  echo "[$(date -u +'%Y-%m-%dT%H:%M:%SZ')] [lab-efs-tool-env] $*" | tee -a "$LOG"
}
lab_te_resolve_source() {
  local code f
  code=$(echo "$1" | tr '[:lower:]' '[:upper:]')
  case "$code" in
    PD)
      for f in /data/tools/PD/pdsource /data/tools/pdsource; do
        [ -f "$f" ] && { echo "$f"; return 0; }
      done
      echo "/data/tools/PD/pdsource"
      ;;
    DV)
      for f in /data/tools/DV/dvsource /data/tools/dvsource; do
        [ -f "$f" ] && { echo "$f"; return 0; }
      done
      echo "/data/tools/DV/dvsource"
      ;;
    AL)
      for f in /data/tools/AL/alsource /data/tools/alsource; do
        [ -f "$f" ] && { echo "$f"; return 0; }
      done
      echo "/data/tools/AL/alsource"
      ;;
    *) return 1 ;;
  esac
}
install -d /etc/lab
TOOLS_FROM_ENV=""
[ -r /etc/lab/efs-mount.env ] && . /etc/lab/efs-mount.env
if [ -n "$(echo $TOOLS_LIST | tr -d '[:space:]')" ]; then
  TOOLS_FROM_ENV="$TOOLS_LIST"
fi
: >/etc/lab/efs-tool-sources.lst
LAB_EFS_HAS_EXTRA=0
if [ -r /etc/lab/efs-tool-sources.extra.lst ]; then
  while IFS= read -r f || [ -n "$f" ]; do
    case "$f" in ''|'#'*) continue ;; *yam4tp*) continue ;; esac
    LAB_EFS_HAS_EXTRA=1
    grep -qxF "$f" /etc/lab/efs-tool-sources.lst 2>/dev/null || echo "$f" >>/etc/lab/efs-tool-sources.lst
    lab_te_log "source -> $f (extra.lst)"
  done </etc/lab/efs-tool-sources.extra.lst
fi
if [ "$LAB_EFS_HAS_EXTRA" != "1" ]; then
  for code in $TOOLS_FROM_ENV; do
    [ -z "$code" ] && continue
    path=$(lab_te_resolve_source "$code") || continue
    [ -z "$path" ] && continue
    grep -qxF "$path" /etc/lab/efs-tool-sources.lst 2>/dev/null || echo "$path" >>/etc/lab/efs-tool-sources.lst
    if [ -f "$path" ]; then
      lab_te_log "source -> $path (exists)"
    else
      lab_te_log "WARN source -> $path (missing)"
    fi
  done
fi
cp -a /etc/lab/efs-tool-sources.lst /etc/lab/efs-tool-sources.raw.lst 2>/dev/null || true
[ -x /usr/local/sbin/lab-pd-env-harden.sh ] && /usr/local/sbin/lab-pd-env-harden.sh || true
LABEFSTOOLENV
chmod +x /usr/local/sbin/lab-efs-tool-env.sh

cat >/etc/systemd/system/lab-efs-mount.service <<'LABEFSSVC'
[Unit]
Description=Lab FSx Lustre per-path mounts under /data
After=network-online.target
Wants=network-online.target
DefaultDependencies=yes

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=600
ExecStartPre=-/bin/systemctl reset-failed lab-efs-mount.service
ExecStart=/usr/local/sbin/lab-efs-mount.sh
StandardOutput=append:/var/log/lab-bootstrap.log
StandardError=append:/var/log/lab-bootstrap.log

[Install]
WantedBy=multi-user.target
LABEFSSVC

cat >/etc/cron.d/semiconlabs-lab-efs-mount <<'LABEFSCRON'
SHELL=/bin/bash
@reboot root sleep 60 && /usr/local/sbin/lab-efs-mount.sh >>/var/log/lab-bootstrap.log 2>&1
LABEFSCRON

systemctl daemon-reload 2>/dev/null || true
systemctl enable lab-efs-mount.service 2>/dev/null || true
lab_log "Lustre: enabled lab-efs-mount.service + @reboot cron (FSx DNS=${trimspace(lab_fsx_lustre_dns)}; per-path mounts under /data)"
lab_log "Lustre: starting lab-efs-mount.service in background (AD join is critical path)"
systemctl start lab-efs-mount.service 2>/dev/null &

mkdir -p /etc/lab
cat >/etc/lab/efs-mount.env <<'LABLUSTRENV'
STORAGE_BACKEND=lustre
DATA_ROOT=/data
FSX_DNS='${trimspace(lab_fsx_lustre_dns)}'
FSX_MOUNT_NAME='${trimspace(lab_fsx_lustre_mount_name)}'
TOOLS_LIST='${join(" ", lab_efs_tools_mount_codes)}'
LABLUSTRENV
chown root:root /etc/lab /etc/lab/efs-mount.env
chmod 0755 /etc/lab /etc/lab/efs-mount.env

cat >/usr/local/sbin/lab-efs-mount.sh <<'LABLUSTREMOUNT'
#!/bin/bash
set -uo pipefail
LOG=/var/log/lab-bootstrap.log
lab_log() {
  echo "[$$(date -u +'%Y-%m-%dT%H:%M:%SZ')] [lab-lustre-mount] $$*" | tee -a "$$LOG"
}
[ -r /etc/lab/efs-mount.env ] || { lab_log "missing /etc/lab/efs-mount.env"; exit 1; }
. /etc/lab/efs-mount.env
DATA_ROOT="$${DATA_ROOT:-/data}"

mkdir -p /var/lock
exec 9>/var/lock/lab-lustre-mount.lock
if ! flock -n 9; then
  lab_log "another remount in progress; waiting for lock"
  flock 9
fi

lab_prepare_mount_point() {
  local mp="$$1"
  local parent
  [ -n "$$mp" ] || return 1
  [ -d "$$mp" ] && return 0
  if [ -e "$$mp" ]; then
    mv "$$mp" "$${mp}.lab-pre-mount" 2>/dev/null || rm -f "$$mp" 2>/dev/null || true
  fi
  parent=$$(dirname "$$mp")
  if lab_is_lustre_at /data || lab_is_lustre_at "$$parent"; then
    lab_log "WARN: prepare $$mp while lustre parent present — clearing legacy full mounts"
    lab_clear_legacy_full_mounts || true
  fi
  mkdir -p "$$mp" || return 1
}

lab_is_lustre_at() {
  local mp="$$1"
  [ -n "$$mp" ] || return 1
  awk -v mp="$$mp" '$$2 == mp && $$3 == "lustre" { found=1; exit } END { exit !found }' /proc/mounts 2>/dev/null
}

lab_rm_empty_yam4tp() {
  local f="$$1"
  [ -e "$$f" ] || return 0
  if [ -f "$$f" ] && [ ! -s "$$f" ]; then
    rm -f "$$f" 2>/dev/null && lab_log "OK: removed empty $$f" || true
  elif [ -d "$$f" ] && [ -z "$$(ls -A "$$f" 2>/dev/null)" ]; then
    rmdir "$$f" 2>/dev/null && lab_log "OK: removed empty dir $$f" || true
  fi
}

lab_prune_empty_nested_tool_dirs() {
  local code="$$1"
  local base nested tools_dir
  case "$$code" in
    PD|DV|AL) ;;
    *) return 0 ;;
  esac
  base="$${DATA_ROOT}/tools/$${code}"
  [ -d "$$base" ] || return 0
  tools_dir="$${base}/tools"
  nested="$${base}/tools/$${code}"
  lab_rm_empty_yam4tp "$${tools_dir}/yam4tp"
  lab_rm_empty_yam4tp "$${base}/yam4tp"
  lab_rm_empty_yam4tp "$${DATA_ROOT}/tools/yam4tp"
  if [ -d "$$nested" ]; then
    if [ -n "$$(find "$$nested" -mindepth 1 -maxdepth 1 ! -name lost+found -print -quit 2>/dev/null)" ]; then
      lab_log "SKIP: nested $$nested is not empty — leave for IT cleanup"
    elif rmdir "$$nested" 2>/dev/null; then
      lab_log "OK: removed empty nested $$nested"
    else
      lab_log "WARN: could not rmdir empty nested $$nested"
    fi
  fi
  if [ -d "$$tools_dir" ] && [ -z "$$(ls -A "$$tools_dir" 2>/dev/null)" ]; then
    rmdir "$$tools_dir" 2>/dev/null && lab_log "OK: removed empty $$tools_dir" || true
  fi
}

lab_drop_fut_x() {
  case " $$(echo "$$TOOLS_LIST" | tr '[:lower:]' '[:upper:]') " in *" FUTURENSE "*) ;; *) return 0 ;; esac
  local rel dst
  for rel in semicon_labs_pd DV; do
    dst="$${DATA_ROOT}/$$rel"
    if lab_is_lustre_at "$$dst" || mountpoint -q "$$dst" 2>/dev/null; then lab_umount_target "$$dst" || true; fi
    [ -d "$$dst" ] && ! lab_is_lustre_at "$$dst" && ! mountpoint -q "$$dst" 2>/dev/null && rmdir "$$dst" 2>/dev/null || true
  done
}

lab_prune_stray_root_tools() {
  if awk '$$2 == "/tools" { found=1; exit } END { exit !found }' /proc/mounts 2>/dev/null; then
    return 0
  fi
  lab_rm_empty_yam4tp /tools/yam4tp
  if [ -d /tools ] && [ -z "$$(ls -A /tools 2>/dev/null)" ]; then
    rmdir /tools 2>/dev/null && lab_log "OK: removed empty /tools" || true
  fi
}

lab_prune_nested_for_tools_list() {
  local c
  for c in $$TOOLS_LIST; do
    [ -z "$$c" ] && continue
    case "$$(echo "$$c" | tr '[:lower:]' '[:upper:]')" in
      PD|FUTURENSE) lab_prune_empty_nested_tool_dirs PD ;;
      DV) lab_prune_empty_nested_tool_dirs DV ;;
      AL) lab_prune_empty_nested_tool_dirs AL ;;
    esac
  done
  case " $$(echo "$$TOOLS_LIST" | tr '[:lower:]' '[:upper:]') " in
    *" FUTURENSE "*) lab_prune_empty_nested_tool_dirs DV ;;
  esac
  lab_prune_stray_root_tools
}

lab_has_lustre_children_under_data() {
  awk '$$3 == "lustre" && $$2 ~ /^\/data\// { found=1; exit } END { exit !found }' /proc/mounts 2>/dev/null
}

lab_fsx_host() {
  local host ip
  host="$${FSX_DNS:-}"
  case "$$host" in
    *.*) ;;
    *)
      lab_log "FAIL: FSX_DNS must be a hostname or IP (got '$$host')"
      return 1
      ;;
  esac
  case "$$host" in
    *[!0-9.]* ) ;;
    *)
      echo "$$host"
      return 0
      ;;
  esac
  ip=$$(getent ahosts "$$host" 2>/dev/null | awk 'NR==1{print $$1; exit}')
  if [ -n "$$ip" ]; then
    echo "$$ip"
    return 0
  fi
  echo "$$host"
  return 0
}

lab_umount_target() {
  local t="$$1"
  if umount "$$t" 2>/dev/null; then
    return 0
  fi
  if [ "$$t" = "/data" ]; then
    lab_log "WARN: hard umount /data failed; not using lazy umount"
    return 1
  fi
  umount -l "$$t" 2>/dev/null || true
}

lab_clear_legacy_full_mounts() {
  local m t
  for m in /PD /AL /DV /tools /data/tools /var/lib/lab/fsx /mnt/data /mnt/lab-fsx; do
    if mountpoint -q "$$m" 2>/dev/null || lab_is_lustre_at "$$m"; then
      lab_umount_target "$$m" || true
      lab_log "OK: umount legacy $$m"
    fi
  done
  if lab_is_lustre_at /data; then
    lab_log "WARN: /data is a full lustre mount — dumping lustre targets: $$(awk '$$3=="lustre"{printf "%s ", $$2}' /proc/mounts)"
    if lab_has_lustre_children_under_data; then
      lab_log "WARN: unmounting /data/* children before clearing full /data"
      awk '$$3 == "lustre" && $$2 ~ /^\/data\// { print $$2 }' /proc/mounts 2>/dev/null | sort -r | while read -r t; do
        [ -n "$$t" ] || continue
        lab_umount_target "$$t" || true
        lab_log "OK: umount child $$t"
      done
    fi
    lab_umount_target /data || umount -f /data 2>/dev/null || true
    if lab_is_lustre_at /data; then
      lab_log "FAIL: /data still full lustre mount"
      return 1
    fi
    lab_log "OK: umount full lustre from /data"
  fi
  mkdir -p "$${DATA_ROOT}" 2>/dev/null || true
  return 0
}

lab_ensure_lustre_module() {
  local i out
  for i in 1 2 3 4 5 6; do
    if lsmod 2>/dev/null | grep -qE '^lustre\b' || [ -d /sys/module/lustre ]; then
      return 0
    fi
    out=$$(modprobe lustre 2>&1) || true
    [ -n "$$out" ] && lab_log "modprobe lustre: $$out"
    modprobe lnet 2>/dev/null || true
    modprobe lustre 2>/dev/null || true
    sleep "$$i"
  done
  if lsmod 2>/dev/null | grep -qE 'lustre' || [ -d /sys/module/lustre ]; then
    return 0
  fi
  lab_log "FAIL lustre kernel module not loaded (lsmod=$$(lsmod 2>/dev/null | grep -i lustre || echo none))"
  return 1
}

lab_lustre_mount_path() {
  local rel="$$1"
  local dst="$${DATA_ROOT}/$$rel"
  local host remote_rel remote_rels attempt spec spec_it
  lab_prepare_mount_point "$$dst" || return 1
  if lab_is_lustre_at "$$dst"; then
    lab_log "OK: already lustre $$dst"
    return 0
  fi
  host=$$(lab_fsx_host) || return 1
  case "$${FSX_MOUNT_NAME}" in
    '')
      lab_log "FAIL: FSX_MOUNT_NAME empty"
      return 1
      ;;
  esac
  lab_ensure_lustre_module || return 1
  remote_rels="$$rel"
  for remote_rel in $$remote_rels; do
    spec="$${host}@tcp:/$${FSX_MOUNT_NAME}/$${remote_rel}"
    spec_it="$${host}:/$${FSX_MOUNT_NAME}/$${remote_rel}"
    for attempt in 1 2 3; do
      if lab_is_lustre_at "$$dst"; then
        lab_log "OK: already lustre $$dst"
        return 0
      fi
      if lab_is_lustre_at /data; then
        lab_log "WARN: full /data lustre present before mounting $$dst; clearing"
        lab_clear_legacy_full_mounts || true
        lab_prepare_mount_point "$$dst" || return 1
      fi
      if findmnt -n "$$dst" >/dev/null 2>&1 || mountpoint -q "$$dst" 2>/dev/null; then
        lab_umount_target "$$dst" || true
      fi
      if timeout 90 mount -t lustre -o relatime,flock "$$spec" "$$dst" 2>&1 | tee -a "$$LOG"; then
        if lab_is_lustre_at "$$dst" && ! lab_is_lustre_at /data; then
          lab_log "OK: mount -t lustre $$spec $$dst (attempt $$attempt)"
          return 0
        fi
      fi
      if timeout 90 mount -t lustre "$$spec_it" "$$dst" 2>&1 | tee -a "$$LOG"; then
        if lab_is_lustre_at "$$dst" && ! lab_is_lustre_at /data; then
          lab_log "OK: mount -t lustre $$spec_it $$dst (attempt $$attempt)"
          return 0
        fi
      fi
      if timeout 90 mount -t lustre -o relatime,flock "$$spec_it" "$$dst" 2>&1 | tee -a "$$LOG"; then
        if lab_is_lustre_at "$$dst" && ! lab_is_lustre_at /data; then
          lab_log "OK: mount -t lustre -o relatime,flock $$spec_it $$dst (attempt $$attempt)"
          return 0
        fi
      fi
      lab_log "RETRY $$attempt/3: lustre $$remote_rel -> $$dst"
      sleep $$((attempt * 2))
    done
    lab_log "WARN: remote fileset $$remote_rel failed; trying next candidate"
  done
  lab_log "FAIL: lustre mount $$rel -> $$dst (tried: $$remote_rels)"
  return 1
}

lab_mount_domain_paths() {
  local c rel seen_pdk=0 fail=0
  mkdir -p "$${DATA_ROOT}" 2>/dev/null || true
  for c in $$TOOLS_LIST; do
    [ -z "$$c" ] && continue
    case "$$(echo "$$c" | tr '[:lower:]' '[:upper:]')" in
      PD)
        for rel in tools/PD semicon_labs_pd pdk; do
          lab_lustre_mount_path "$$rel" || fail=1
        done
        lab_prune_empty_nested_tool_dirs PD
        seen_pdk=1
        ;;
      DV)
        for rel in tools/DV DV; do
          lab_lustre_mount_path "$$rel" || fail=1
        done
        lab_prune_empty_nested_tool_dirs DV
        ;;
      AL)
        for rel in tools/AL CL_PDK layout_labs; do
          lab_lustre_mount_path "$$rel" || fail=1
        done
        lab_prune_empty_nested_tool_dirs AL
        ;;
      FUTURENSE)
        for rel in tools/PD pdk tools/DV futurense_modules; do
          lab_lustre_mount_path "$$rel" || fail=1
        done
        lab_prune_empty_nested_tool_dirs PD
        lab_prune_empty_nested_tool_dirs DV
        ;;
      *)
        lab_log "WARN: unknown TOOLS_LIST code '$$c'"
        ;;
    esac
  done
  return $$fail
}

lab_verify_mounts() {
  local c fail=0
  if lab_is_lustre_at "$${DATA_ROOT}"; then
    lab_log "VERIFY FAIL: $${DATA_ROOT} is a full lustre mount (want per-path only) mounts=$$(awk '$$3=="lustre"{printf "%s->%s ", $$1, $$2}' /proc/mounts)"
    fail=1
  else
    lab_log "VERIFY OK: $${DATA_ROOT} is not a full FSx mount"
  fi
  for c in $$TOOLS_LIST; do
    [ -z "$$c" ] && continue
    case "$$(echo "$$c" | tr '[:lower:]' '[:upper:]')" in
      PD)
        for rel in semicon_labs_pd tools/PD pdk; do
          if lab_is_lustre_at "$${DATA_ROOT}/$$rel"; then
            lab_log "VERIFY OK: $${DATA_ROOT}/$$rel (lustre)"
          else
            lab_log "VERIFY FAIL: $${DATA_ROOT}/$$rel not lustre-mounted"
            fail=1
          fi
        done
        if [ -e /data/tools/PD/pdsource ]; then
          lab_log "VERIFY OK: /data/tools/PD/pdsource"
        else
          lab_log "VERIFY WARN: /data/tools/PD/pdsource missing"
        fi
        ;;
      DV)
        for rel in DV tools/DV; do
          if lab_is_lustre_at "$${DATA_ROOT}/$$rel"; then
            lab_log "VERIFY OK: $${DATA_ROOT}/$$rel (lustre)"
          else
            lab_log "VERIFY FAIL: $${DATA_ROOT}/$$rel not lustre-mounted"
            fail=1
          fi
        done
        ;;
      AL)
        for rel in tools/AL CL_PDK layout_labs; do
          if lab_is_lustre_at "$${DATA_ROOT}/$$rel"; then
            lab_log "VERIFY OK: $${DATA_ROOT}/$$rel (lustre)"
          else
            lab_log "VERIFY FAIL: $${DATA_ROOT}/$$rel not lustre-mounted"
            fail=1
          fi
        done
        ;;
      FUTURENSE)
        for rel in tools/PD pdk tools/DV futurense_modules; do
          if lab_is_lustre_at "$${DATA_ROOT}/$$rel"; then
            lab_log "VERIFY OK: $${DATA_ROOT}/$$rel (lustre)"
          else
            lab_log "VERIFY FAIL: $${DATA_ROOT}/$$rel not lustre-mounted"
            fail=1
          fi
        done
        ;;
    esac
  done
  return $$fail
}

lab_paths_already_ok() {
  local c rel
  if lab_is_lustre_at "$${DATA_ROOT}"; then
    return 1
  fi
  for c in $$TOOLS_LIST; do
    [ -z "$$c" ] && continue
    case "$$(echo "$$c" | tr '[:lower:]' '[:upper:]')" in
      PD)
        for rel in semicon_labs_pd tools/PD pdk; do
          lab_is_lustre_at "$${DATA_ROOT}/$$rel" || return 1
        done
        ;;
      DV)
        for rel in DV tools/DV; do
          lab_is_lustre_at "$${DATA_ROOT}/$$rel" || return 1
        done
        ;;
      AL)
        for rel in tools/AL CL_PDK layout_labs; do
          lab_is_lustre_at "$${DATA_ROOT}/$$rel" || return 1
        done
        ;;
      FUTURENSE)
        for rel in tools/PD pdk tools/DV futurense_modules; do
          lab_is_lustre_at "$${DATA_ROOT}/$$rel" || return 1
        done
        ;;
    esac
  done
  [ -n "$$(echo "$$TOOLS_LIST" | tr -d '[:space:]')" ]
}

lab_run_mount_pass() {
  local mount_rc=0
  if lab_paths_already_ok; then
    lab_drop_fut_x
    lab_verify_mounts || true
    lab_prune_nested_for_tools_list
    lab_log "already healthy; skipped remount, ran nested-dir prune"
    return 0
  fi
  lab_clear_legacy_full_mounts || return 1
  lab_ensure_lustre_module || return 1
  if ! command -v timeout >/dev/null 2>&1; then
    lab_log "WARN timeout command missing"
    return 1
  fi
  mkdir -p "$${DATA_ROOT}" 2>/dev/null || true
  lab_drop_fut_x
  lab_mount_domain_paths || mount_rc=1
  lab_drop_fut_x
  lab_prune_nested_for_tools_list
  lab_verify_mounts || mount_rc=1
  return $$mount_rc
}

lab_log "start FSx Lustre FSX_DNS=$${FSX_DNS} mount=$${FSX_MOUNT_NAME} data=$${DATA_ROOT} tools=[$$TOOLS_LIST] (per-path safe)"
_max_pass=4
_pass=0
while [ "$$_pass" -lt "$$_max_pass" ]; do
  _pass=$$((_pass + 1))
  lab_log "=== Lustre mount pass $$_pass/$$_max_pass ==="
  if lab_run_mount_pass; then
    /usr/local/sbin/lab-efs-tool-env.sh 2>/dev/null || true
    lab_log "SUMMARY OK (pass $$_pass)"
    exit 0
  fi
  [ "$$_pass" -lt "$$_max_pass" ] && sleep $$((_pass * 10))
done
lab_log "FAIL Lustre mounts after $$_max_pass attempts"
exit 1
LABLUSTREMOUNT
chmod +x /usr/local/sbin/lab-efs-mount.sh

cat >/usr/local/sbin/lab-efs-tool-env.sh <<'LABEFSTOOLENV'
#!/bin/bash
set -uo pipefail
install -d /etc/lab
TOOLS_LIST=""; [ -r /etc/lab/efs-mount.env ] && . /etc/lab/efs-mount.env || true
: >/etc/lab/efs-tool-sources.lst
if [ -r /etc/lab/efs-tool-sources.extra.lst ]; then
  while IFS= read -r f || [ -n "$f" ]; do
    case "$f" in ''|'#'*|*yam4tp*) continue ;; esac
    grep -qxF "$f" /etc/lab/efs-tool-sources.lst 2>/dev/null || echo "$f" >>/etc/lab/efs-tool-sources.lst
  done </etc/lab/efs-tool-sources.extra.lst
fi
if [ ! -s /etc/lab/efs-tool-sources.lst ]; then
  for code in $TOOLS_LIST; do
    C=$(echo "$code" | tr '[:lower:]' '[:upper:]')
    case "$C" in
      PD) for f in /data/tools/PD/pdsource /data/tools/pdsource; do [ -f "$f" ] && { echo "$f" >>/etc/lab/efs-tool-sources.lst; break; }; done ;;
      DV) for f in /data/tools/DV/dvsource /data/tools/dvsource; do [ -f "$f" ] && { echo "$f" >>/etc/lab/efs-tool-sources.lst; break; }; done ;;
      AL) for f in /data/tools/AL/alsource /data/tools/alsource; do [ -f "$f" ] && { echo "$f" >>/etc/lab/efs-tool-sources.lst; break; }; done ;;
    esac
  done
fi
cp -a /etc/lab/efs-tool-sources.lst /etc/lab/efs-tool-sources.raw.lst 2>/dev/null || true
[ -x /usr/local/sbin/lab-pd-env-harden.sh ] && /usr/local/sbin/lab-pd-env-harden.sh || true
LABEFSTOOLENV
chmod +x /usr/local/sbin/lab-efs-tool-env.sh

cat >/etc/systemd/system/lab-efs-mount.service <<'LABEFSSVC'
[Unit]
Description=Lab FSx Lustre mounts under /data
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=600
ExecStartPre=-/bin/systemctl reset-failed lab-efs-mount.service
ExecStart=/usr/local/sbin/lab-efs-mount.sh
StandardOutput=append:/var/log/lab-bootstrap.log
StandardError=append:/var/log/lab-bootstrap.log

[Install]
WantedBy=multi-user.target
LABEFSSVC

rm -f /etc/cron.d/semiconlabs-lab-efs-mount 2>/dev/null || true
systemctl daemon-reload 2>/dev/null || true
systemctl enable lab-efs-mount.service 2>/dev/null || true
lab_log "Lustre: enable+start lab-efs-mount (dns=${trimspace(lab_fsx_lustre_dns)})"
systemctl start lab-efs-mount.service 2>/dev/null &
